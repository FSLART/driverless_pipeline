# Packages from other repositories. The dev container clones them into src/external
# when it is created (vcs import); update them with: vcs pull src/external
repositories:
  lart_msgs:
    type: git
    url: https://github.com/FSLART/lart_msgs.git
    version: main
  xsens:
    type: git
    url: https://github.com/xsenssupport/Xsens_MTi_ROS_Driver_and_Ntrip_Client.git
    version: ros2
  rosbag2_composable_recorder:
    type: git
    url: https://github.com/berndpfrommer/rosbag2_composable_recorder.git
    version: master
